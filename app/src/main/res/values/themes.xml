<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is painted before Compose's first frame: same grounds as YoloCTheme, so
         starting in dark mode never flashes white (values-night has the dark version). -->
    <style name="Theme.Yoloc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Redesign 2026-10-31: the system splash (core-splashscreen). The icon's artwork already
         sits inside the splash icon's safe circle. MainActivity switches to Theme.Yoloc. -->
    <style name="Theme.Yoloc.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yoloc</item>
    </style>
</resources>
