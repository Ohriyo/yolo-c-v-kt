# Normalize line endings to LF in the repo (same as the RN repo).
* text=auto eol=lf
# Windows scripts need CRLF to run reliably.
*.bat text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.jar binary

# Model binaries are tracked with Git LFS (same as the RN repo).
*.tflite filter=lfs diff=lfs merge=lfs -text
